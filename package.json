{
  "name": "smartaipengkaji",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "description": "Smart AI Konsultan Pengkaji Sertifikat Laik Fungsi (SLF) - Sistem berbasis AI untuk pengkajian teknis bangunan gedung",
  "scripts": {
    "audit:all": "npm run audit:code && npm run audit:egress && npm run audit:deep",
    "audit:code": "node scripts/code-audit.mjs",
    "audit:code:json": "node scripts/code-audit.mjs --json code-audit.json",
    "audit:deep": "node scripts/deep-audit.mjs",
    "audit:deep:json": "node scripts/deep-audit.mjs --json deep-audit.json",
    "audit:egress": "node scripts/egress-audit.mjs",
    "audit:egress:json": "node scripts/egress-audit.mjs --json egress-audit.json",
    "build": "vite build",
    "check:bundle": "node scripts/check-bundle-secrets.mjs",
    "check:secrets": "node scripts/check-client-secrets.mjs",
    "db:schema-sync": "node scripts/db-schema-sync.mjs",
    "db:schema-sync:dry": "node scripts/db-schema-sync.mjs --dry",
    "deploy-all": "npm run build && npm run deploy-gas",
    "deploy-gas": "cd gas && clasp push && clasp deploy",
    "dev": "vite",
    "keepalive": "node scripts/keepalive.mjs",
    "keepalive:force": "node scripts/keepalive.mjs --force --verbose",
    "postbuild": "npm run check:bundle",
    "prebuild": "npm run check:secrets",
    "preview": "vite preview",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:ui": "vitest --ui"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.4",
    "@vitest/ui": "^4.1.4",
    "happy-dom": "^20.9.0",
    "jsdom": "^26.0.0",
    "pg": "^8.23.0",
    "terser": "^5.46.1",
    "vite": "^6.0.0",
    "vitest": "^4.1.4"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.101.1",
    "chart.js": "^4.5.1",
    "docx": "^9.6.1",
    "docx-preview": "^0.3.7",
    "docxtemplater": "^3.55.1",
    "dompurify": "^3.3.3",
    "dxf-parser": "^1.1.2",
    "file-saver": "^2.0.5",
    "html2canvas": "^1.4.1",
    "idb": "^8.0.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "marked": "^17.0.5",
    "pizzip": "^3.1.7",
    "tesseract.js": "^7.0.0",
    "three": "^0.183.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
