# ============================================================
#  TEMPLATE KONFIGURASI — Smart AI Pengkaji SLF
#
#  Cara pakai:
#    cp .env.example .env      (Windows: copy .env.example .env)
#    lalu isi nilainya.
#
#  .env TIDAK boleh di-commit (sudah masuk .gitignore).
#
#  Hanya variabel berawalan VITE_ (dan NEXT_PUBLIC_) yang dibaca
#  browser. Variabel tanpa awalan VITE hanya tersedia saat build
#  (mis. untuk skrip Node & Edge Function).
#
#  Dokumentasi lengkap: docs/SUPABASE-SETUP.md
# ============================================================


# ────────────────────────────────────────────────────────────
#  1. SUPABASE (WAJIB — tanpa ini aplikasi tidak bisa login)
#     Dashboard Supabase → Project Settings → API
# ────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.ISIKAN_ANON_KEY

# Alternatif format kunci baru (publishable key). Kode membaca
# variabel ini lebih dulu daripada VITE_SUPABASE_ANON_KEY.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=sb_publishable_xxxxxxxx


# ────────────────────────────────────────────────────────────
#  2. IDENTITAS APLIKASI (opsional)
# ────────────────────────────────────────────────────────────
VITE_APP_NAME=Smart AI Pengkaji SLF
VITE_APP_VERSION=2.1.0
# Base URL saat di-deploy (mis. https://user.github.io/repo). Kosongkan bila tidak yakin.
VITE_BASE_URL=


# ────────────────────────────────────────────────────────────
#  3. FITUR AI (opsional)
#     Di produksi, kunci AI sebaiknya HANYA disimpan di server
#     (Supabase Edge Function `ai-proxy`), bukan di .env klien.
#     Variabel di bawah hanya untuk pengembangan lokal.
# ────────────────────────────────────────────────────────────
VITE_ENABLE_AI=true
# URL Edge Function ai-proxy bila memakai proxy server-side
VITE_AI_PROXY_URL=
VITE_EDGE_FUNCTION_BASE=

# ────────────────────────────────────────────────────────────
#  ⚠️  KUNCI AI DI BAWAH INI — HANYA UNTUK PENGEMBANGAN LOKAL
#
#  Setiap nilai berawalan VITE_ akan DISALIN SEBAGAI TEKS BIASA ke dalam
#  berkas JS publik saat `npm run build`. Jadi kunci yang terisi di sini
#  saat build akan terbit ke internet dan dapat dipakai orang lain atas
#  biaya Anda. Tidak ada cara menyembunyikannya di sisi klien.
#
#  Karena itu:
#    - BIARKAN KOSONG pada .env yang dipakai untuk build produksi;
#    - `npm run build` akan GAGAL bila mendeteksi kunci AI di environment
#      (lihat scripts/check-client-secrets.mjs);
#    - di produksi, aplikasi memakai Edge Function `ai-proxy` — isi
#      VITE_AI_PROXY_URL di atas, dan simpan kunci sebenarnya sebagai
#      secret Supabase:
#          supabase secrets set GEMINI_API_KEY=... OPENROUTER_API_KEY=... KIMI_API_KEY=...
# ────────────────────────────────────────────────────────────
#  TIDAK ADA variabel kunci AI di berkas ini — dan itu disengaja.
#
#  Versi sebelumnya mendaftarkan VITE_GEMINI_API_KEY=, VITE_OPENROUTER_API_KEY=,
#  dan VITE_KIMI_API_KEY= sebagai baris kosong. Baris kosong itu mengundang
#  untuk diisi, padahal mengisinya berarti mengirim kunci ke bundel publik.
#  Barisnya dihapus supaya tidak ada yang terisi karena kebiasaan.
#
#  Variabel ini MASIH dibaca beberapa modul — src/lib/ai-router.js,
#  src/lib/gemini.js, dan src/infrastructure/ai/AIRouter.js — tetapi hanya
#  sebagai PEMERIKSAAN KETERSEDIAAN. Bila kosong (keadaan yang benar untuk
#  produksi), modul-modul itu memakai Edge Function `ai-proxy`, dan itulah
#  jalur yang seharusnya dipakai. Mengisinya tidak diperlukan sama sekali.
#
#  Bila kunci pernah terisi di berkas ini sebelumnya, anggap kunci itu BOCOR
#  dan rotasi di penyedianya.


# ────────────────────────────────────────────────────────────
#  4. INTEGRASI GOOGLE APPS SCRIPT / GOOGLE DRIVE (opsional)
# ────────────────────────────────────────────────────────────
VITE_GOOGLE_APPS_SCRIPT_URL=
VITE_GAS_API_URL=
VITE_ENABLE_GAS_INTEGRATION=false


# ============================================================
#  5. EGRESS GUARD — penghemat kuota Supabase
#     Dokumentasi: docs/EGRESS-MITIGATION.md
# ============================================================

# Matikan total proteksi egress (mis. saat debugging cache):
#   VITE_EGRESS_GUARD=off
VITE_EGRESS_GUARD=on

# Cetak setiap HIT / MISS / REVALIDATE ke console browser
# VITE_EGRESS_DEBUG=on

# TTL cache REST untuk tabel yang tidak terdaftar (ms). Default: 30000
# VITE_EGRESS_CACHE_TTL_MS=30000

# Umur maksimum data basi yang boleh disajikan saat offline (ms). Default: 7 hari
# VITE_EGRESS_MAX_STALE_MS=604800000

# Batas ukuran cache IndexedDB (MB). Default: 12
# VITE_EGRESS_CACHE_MB=12

# Peringatan bila byte masuk dalam satu sesi melewati ambang ini (MB). Default: 30
# VITE_EGRESS_BUDGET_MB=30

# Interval laporan egress otomatis ke console (ms). Default: 5 menit
# VITE_EGRESS_REPORT_MS=300000


# ============================================================
#  6. KEEPALIVE — mencegah proyek Free di-pause (7 hari idle)
#     Lapisan: GitHub Actions (2 hari) + aplikasi + Edge Function
#     Dokumentasi: docs/EGRESS-MITIGATION.md
# ============================================================

# Interval ping dari klien (jam). Default: 48
# KEEPALIVE_INTERVAL_HOURS=48


# ============================================================
#  7. VARIABEL SISI SERVER (TIDAK punya awalan VITE_ → tidak
#     pernah ikut ke bundel klien)
# ============================================================

# Dipakai `npm run db:schema-sync` untuk membaca skema database dan
# menghasilkan migrasi bagi tabel yang belum ada di repositori.
# Ambil dari: Dashboard → Project Settings → Database → Connection string → URI
#   export SUPABASE_DB_URL='postgresql://postgres.<ref>:<PASSWORD>@...:5432/postgres'
#
# JANGAN ditulis di .env — cukup dari shell, agar tidak pernah terbaca
# oleh proses build klien. (SUPABASE_DB_URL tanpa awalan VITE_ memang
# tidak ikut ke bundel, tetapi password database sebaiknya tidak
# disimpan berdampingan dengan berkas yang mungkin ter-commit.)
SUPABASE_DB_URL=
